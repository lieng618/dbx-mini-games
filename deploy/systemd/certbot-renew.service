[Unit]
Description=Renew Let's Encrypt IP certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/dbx-mini-games/deploy/systemd/certbot-renew.sh
# Restore Caddy even when certbot is killed before its own post hook can run.
ExecStopPost=-/bin/systemctl start caddy
TimeoutStartSec=600
