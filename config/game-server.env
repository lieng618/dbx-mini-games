# Public origin embedded into the plugin and used by Caddy.
# Replace this single value when moving to a domain or another public IP.
PUBLIC_ORIGIN=https://1.92.64.227
PUBLIC_HOST=1.92.64.227

# WebSocket endpoint on PUBLIC_ORIGIN.
WEBSOCKET_PATH=/ws

# Local development server used by `npm run dev`.
LOCAL_ORIGIN=http://127.0.0.1:8787
